<mujoco model="glider_v1">
  <!-- CFD 侧参数化几何产物 (gen_airframe.m v1) — B 系 x前弹轴 y右 z下
       默认参数 = 占位 glider_phase0.urdf 咬合; 零舵偏 STL 见同目录 fin_*.stl -->
  <compiler angle="radian" meshdir="."/>
  <option timestep="0.002"/>   <!-- spec §3: 主循环 dt=2ms -->

  <asset>
    <mesh name="body" file="body.stl"/>
  </asset>

  <worldbody>
    <body name="airframe" pos="0 0 0">
      <freejoint name="root"/>
      <inertial pos="-5.464e-18 0 0" mass="10" fullinertia="0.028125 1.21408 1.21408 0 0 0"/>
      <geom name="body_geom" type="mesh" mesh="body" rgba="0.45 0.45 0.5 1"/>

      <!-- 水平对: 铰链轴 y (同向=俯仰 de, 差动=滚转 da) -->
      <body name="fin_h_pos" pos="-0.55 0 0.03">
        <joint name="j_h_pos" type="hinge" axis="0 1 0" range="-0.3491 0.3491"/>
        <inertial pos="-0.05 0 0.09" mass="0.05" fullinertia="6.00375e-05 0.000101667 4.17042e-05 0 0 0"/>
        <geom name="g_h_pos" type="box" size="0.05 0.0015 0.06" pos="-0.05 0 0.09" rgba="0.9 0.5 0.1 1"/>
      </body>
      <body name="fin_h_neg" pos="-0.55 0 0.03">
        <joint name="j_h_neg" type="hinge" axis="0 1 0" range="-0.3491 0.3491"/>
        <inertial pos="-0.05 0 -0.09" mass="0.05" fullinertia="6.00375e-05 0.000101667 4.17042e-05 0 0 0"/>
        <geom name="g_h_neg" type="box" size="0.05 0.0015 0.06" pos="-0.05 0 -0.09" rgba="0.9 0.5 0.1 1"/>
      </body>

      <!-- 垂直对: 铰链轴 z (同向=偏航 dr) -->
      <body name="fin_v_pos" pos="-0.55 0.03 0">
        <joint name="j_v_pos" type="hinge" axis="0 0 1" range="-0.3491 0.3491"/>
        <inertial pos="-0.05 0.09 0" mass="0.05" fullinertia="6.00375e-05 4.17042e-05 0.000101667 0 0 0"/>
        <geom name="g_v_pos" type="box" size="0.05 0.06 0.0015" pos="-0.05 0.09 0" rgba="0.9 0.5 0.1 1"/>
      </body>
      <body name="fin_v_neg" pos="-0.55 0.03 0">
        <joint name="j_v_neg" type="hinge" axis="0 0 1" range="-0.3491 0.3491"/>
        <inertial pos="-0.05 -0.09 0" mass="0.05" fullinertia="6.00375e-05 4.17042e-05 0.000101667 0 0 0"/>
        <geom name="g_v_neg" type="box" size="0.05 0.06 0.0015" pos="-0.05 -0.09 0" rgba="0.9 0.5 0.1 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
