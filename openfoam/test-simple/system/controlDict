FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

version         2.0;

format          ascii;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2000;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      2;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    testSection
    {
        type            surfaces;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   100;
        surfaceFormat   raw;
        fields          (U p);
        samplingScheme  midPoint;
        surfaces
        (
            tsSlice
            {
                type        plane;
                point       (1.65 0 0);
                normal      (1 0 0);
            }
        );
    }
    residuals
    {
        type            residuals;
        libs            ("libutilityFunctionObjects.so");
        fields          (p U);
        writeControl    timeStep;
        writeInterval   100;
    }
}

